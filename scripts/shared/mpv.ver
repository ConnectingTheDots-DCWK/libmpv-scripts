# ELF version script for libmpv.so (Linux; Android uses mpv_android.ver).
# Passed to ld via -Wl,--version-script,...
#
# Only the public mpv_* C API, plus the mak_pcm_* live PCM API listed by name
# (patch_pcm_stream.py), leaks into the .so's dynamic symbol table. All
# statically-linked dep internals (ffmpeg, freetype, fribidi, harfbuzz,
# fontconfig, libass, libplacebo, libsmb2, libxml2, rubberband, speexdsp,
# OpenSSL) stay local — preventing symbol-poisoning when another Flutter
# plugin loads its own copy of these libraries in the same process.
{
  global:
    mpv_*;
    mak_pcm_create;
    mak_pcm_write;
    mak_pcm_finish;
    mak_pcm_abort;
    mak_pcm_buffered;
    mak_pcm_consumed;
    mak_pcm_state;
    mak_pcm_release;
    mak_pcm_release_all;
  local:
    *;
};
