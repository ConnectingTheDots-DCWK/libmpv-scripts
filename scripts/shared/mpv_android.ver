# ELF version script for libmpv.so on Android.
# Passed to ld via -Wl,--version-script,...
#
# Same surface as scripts/shared/mpv.ver (the public mpv_* C API and the
# mak_pcm_* live PCM API) PLUS JNI_OnLoad — the runtime hook Android calls
# when libmpv.so is brought in via System.loadLibrary("mpv"). Compiled into the binary
# from patches/mpv/android/android_jni_bridge.c, it forwards the
# JavaVM* to ffmpeg's `av_jni_set_java_vm()` so audiotrack and other
# JNI-dependent components have a working VM by the time the player
# initializes.
{
  global:
    mpv_*;
    # The mak_pcm_* API as a glob: lld fails the link, and meson's link
    # tests, on a named symbol that is not defined. The first letters
    # leave out the internal mak_pcm_tap_*.
    mak_pcm_[abcfrsw]*;
    JNI_OnLoad;
  local:
    *;
};
